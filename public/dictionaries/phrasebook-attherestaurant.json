      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_10",
      "word": "I know that you're a vegetarian.",
      "translation": "Я знаю, что ты вегетарианец.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_11",
      "word": "I didn't know you were a vegetarian.",
      "translation": "Я не знал, что ты вегетарианец.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_12",
      "word": "Milk is a popular beverage.",
      "translation": "Молоко - популярный напиток.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_13",
      "word": "It's a very healthy beverage.",
      "translation": "Это очень полезный для здоровья напиток.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_14",
      "word": "I need to check.",
      "translation": "Мне нужно проверить.",
