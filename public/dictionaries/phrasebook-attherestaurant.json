{
  "id": "phrasebook-attherestaurant",
  "name": "At the Restaurant",
  "description": "Ресторан от начала до конца: столик, заказ, претензии, счёт",
  "entries": [
    {
      "id": "pbq_restaurant_0",
      "word": "A table for two, please.",
      "translation": "Столик на двоих, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_1",
      "word": "Do you have a table for four?",
      "translation": "У вас есть столик на четверых?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_2",
      "word": "I have a reservation for eight o’clock.",
      "translation": "У меня забронирован столик на восемь.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_3",
      "word": "Under what name?",
      "translation": "На чьё имя?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_4",
      "word": "Under the name Petrov.",
      "translation": "На фамилию Петров.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_5",
      "word": "How long is the wait?",
      "translation": "Сколько ждать свободный столик?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_6",
      "word": "Would you like to sit at the bar while you wait?",
      "translation": "Не хотите подождать за барной стойкой?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_7",
      "word": "Could we sit by the window?",
      "translation": "Можно нам столик у окна?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_8",
      "word": "Is this seat free?",
      "translation": "Это место свободно?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_9",
      "word": "Could we have the menu, please?",
      "translation": "Можно меню, пожалуйста?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_10",
      "word": "Here you are.",
      "translation": "Вот, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_11",
      "word": "Are you ready to order?",
      "translation": "Вы готовы сделать заказ?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_12",
      "word": "What would you recommend?",
      "translation": "Что вы посоветуете?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_13",
      "word": "What's today's special?",
      "translation": "Какое сегодня блюдо дня?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_14",
      "word": "The salmon is very popular here.",
      "translation": "Лосось здесь очень популярен.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_15",
      "word": "I'll have the chicken soup.",
      "translation": "Я возьму куриный суп.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_16",
      "word": "For starters, we’ll share a salad.",
      "translation": "На закуску мы разделим салат.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_17",
      "word": "And for the main course?",
      "translation": "А на основное блюдо?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_18",
      "word": "Steak, medium, please.",
      "translation": "Стейк средней прожарки, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_19",
      "word": "How would you like your steak?",
      "translation": "Как прожарить ваш стейк?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_20",
      "word": "Medium rare, please.",
      "translation": "Слабой прожарки, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_21",
      "word": "Well done, please.",
      "translation": "Полностью прожаренный, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_22",
      "word": "Any sides with that?",
      "translation": "Что-нибудь на гарнир?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_23",
      "word": "French fries, please.",
      "translation": "Картофель фри, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_24",
      "word": "Hold the onions, please.",
      "translation": "Без лука, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_25",
      "word": "No ice, please.",
      "translation": "Без льда, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_26",
      "word": "Are there any nuts in this dish?",
      "translation": "В этом блюде есть орехи?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_27",
      "word": "Does it contain dairy?",
      "translation": "Там есть молочные продукты?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_28",
      "word": "I’m allergic to shellfish.",
      "translation": "У меня аллергия на морепродукты.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_29",
      "word": "I’m a vegetarian.",
      "translation": "Я вегетарианец.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_30",
      "word": "Do you have any vegan options?",
      "translation": "У вас есть веганские блюда?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_31",
      "word": "Do you have a gluten-free menu?",
      "translation": "Есть у вас безглютеновое меню?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_32",
      "word": "Is this dish spicy?",
      "translation": "Это блюдо острое?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_33",
      "word": "Not too spicy, I hope?",
      "translation": "Не слишком острое, надеюсь?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_34",
      "word": "Make it mild, please.",
      "translation": "Сделайте неострым, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_35",
      "word": "Another round of drinks, please.",
      "translation": "Ещё по одному напитку, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_36",
      "word": "Same again, please.",
      "translation": "Повторите заказ, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_37",
      "word": "Excuse me, we’ve been waiting for our order.",
      "translation": "Извините, мы уже давно ждём наш заказ.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_38",
      "word": "This isn’t what I ordered.",
      "translation": "Это не то, что я заказывал.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_39",
      "word": "My soup is cold.",
      "translation": "Мой суп холодный.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_40",
      "word": "The meat is overcooked.",
      "translation": "Мясо пережарено.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_41",
      "word": "There’s a hair in my food!",
      "translation": "В моей еде волос!",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_42",
      "word": "I’m so sorry about that. We’ll replace it right away.",
      "translation": "Мне так жаль. Мы сразу же заменим блюдо.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_43",
      "word": "Everything is delicious!",
      "translation": "Всё очень вкусно!",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_44",
      "word": "Compliments to the chef!",
      "translation": "Комплименты шеф-повару!",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_45",
      "word": "Could we have some more bread?",
      "translation": "Можно ещё немного хлеба?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_46",
      "word": "Can we get this to go?",
      "translation": "Можно это с собой?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_47",
      "word": "Anything for dessert?",
      "translation": "Что-нибудь на десерт?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_48",
      "word": "Just the bill, thank you.",
      "translation": "Просто счёт, спасибо.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_49",
      "word": "Could we get the check, please?",
      "translation": "Нам можно счёт, пожалуйста?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_50",
      "word": "One bill or separate?",
      "translation": "Один счёт или раздельно?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_51",
      "word": "Separate bills, please.",
      "translation": "Раздельные счета, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_52",
      "word": "It’s on me.",
      "translation": "Я угощаю. / С меня.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_53",
      "word": "Let's split the bill.",
      "translation": "Давайте разделим счёт.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_54",
      "word": "We’d like to pay together.",
      "translation": "Мы хотим заплатить вместе.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_55",
      "word": "Do you accept credit cards?",
      "translation": "Вы принимаете кредитные карты?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_56",
      "word": "Cash only, I’m afraid.",
      "translation": "К сожалению, только наличные.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_57",
      "word": "Was everything all right?",
      "translation": "Всё ли вам понравилось?",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_58",
      "word": "Yes, thank you, it was lovely.",
      "translation": "Да, спасибо, всё было чудесно.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_59",
      "word": "Thank you, come again!",
      "translation": "Спасибо, приходите ещё!",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_60",
      "word": "Tip is included in the bill.",
      "translation": "Чаевые включены в счёт.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_61",
      "word": "Service charge is not included.",
      "translation": "Плата за обслуживание не включена.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_62",
      "word": "We don’t tip here.",
      "translation": "Здесь не принято давать чаевые.",
      "language": "en"
    },
    {
      "id": "pbq_restaurant_63",
      "word": "That was a wonderful dinner.",
      "translation": "Это был замечательный ужин.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_0",
      "word": "I used to be a vegetarian.",
