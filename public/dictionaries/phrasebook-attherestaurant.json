    },
    {
      "id": "pb_attherestaurant_0_31",
      "word": "Just check it.",
      "translation": "Просто проверь это.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_33",
      "word": "The only dessert I really like is ice cream.",
      "translation": "Единственный десерт, который я действительно люблю, - мороженое.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_34",
      "word": "My regular waitress wouldn't have anything to do with me.",
      "translation": "Официантка, которая обычно меня обслуживает, не стала бы со мной связываться.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_35",
      "word": "I'll check my schedule.",
      "translation": "Я проверю своё расписание.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_38",
      "word": "He lives paycheck to paycheck.",
      "translation": "Он живёт от зарплаты до зарплаты.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_39",
      "word": "\"Are you a vegetarian?\" \"No. Are you?\"",
      "translation": "\"Вы вегетарианец?\" - \"Нет, а Вы?\"",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_40",
      "word": "It's easy to check.",
      "translation": "Это легко проверить.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_41",
      "word": "There's the waitress.",
      "translation": "А вот и официантка.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_42",
      "word": "He tucked the napkin under his chin.",
      "translation": "Он закрепил салфетку под подбородком.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_43",
      "word": "Check if everything is correct.",
      "translation": "Проверь, всё ли правильно.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_45",
      "word": "I'll check the list.",
      "translation": "Я проверю список.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_46",
      "word": "I'll go check.",
      "translation": "Пойду проверю.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_47",
      "word": "Check this out.",
      "translation": "Проверьте это.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_48",
      "word": "Did you check the mailbox?",
      "translation": "Ты проверял почтовый ящик?",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_49",
      "word": "Check your pockets.",
      "translation": "Проверь карманы.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_0",
      "word": "Hold on. I'll check.",
      "translation": "Не кладите трубку. Я проверю.",
