    {
      "id": "pb_attherestaurant_0_1",
      "word": "What's for dessert?",
      "translation": "Что на десерт?",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_2",
      "word": "I'll check it.",
      "translation": "Я проверю это.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_3",
      "word": "I need to check on something.",
