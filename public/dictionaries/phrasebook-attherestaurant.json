    },
    {
      "id": "pb_attherestaurant_1_4",
      "word": "Apples were served as the dessert.",
      "translation": "Яблоки были поданы на десерт.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_5",
      "word": "Check on the baby.",
      "translation": "Проверь, как там ребёнок.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_7",
      "word": "Check your list.",
      "translation": "Проверь свой список.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_9",
      "word": "I brought some dessert.",
      "translation": "Я принёс десерт.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_11",
      "word": "Check your inbox.",
      "translation": "Проверь свои входящие.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_13",
      "word": "I just had to check on something.",
      "translation": "Мне просто нужно было кое-что проверить.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_14",
      "word": "I need to check something out.",
      "translation": "Мне нужно кое-что проверить.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_1_16",
      "word": "My favorite dessert is ice cream.",
      "translation": "Мой любимый десерт - мороженое.",
      "language": "en"
    },
    {
