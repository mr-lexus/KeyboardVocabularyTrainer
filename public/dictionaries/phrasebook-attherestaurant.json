    },
    {
      "id": "pb_attherestaurant_0_15",
      "word": "We can check.",
      "translation": "Мы можем проверить.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_16",
      "word": "He signed the check.",
      "translation": "Он подписал чек.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_17",
      "word": "This is too spicy for me.",
      "translation": "Это для меня слишком остро.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_18",
      "word": "Lay the napkin across your lap.",
      "translation": "Разложи салфетку на коленях.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_21",
      "word": "Did you check this?",
      "translation": "Ты это проверил?",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_23",
      "word": "Check under the mattress.",
      "translation": "Проверь под матрасом.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_24",
      "word": "We know that you're a vegetarian.",
      "translation": "Мы знаем, что ты вегетарианка.",
      "language": "en"
    },
    {
      "id": "pb_attherestaurant_0_25",
      "word": "I need to check something.",
      "translation": "Мне нужно кое-что проверить.",
