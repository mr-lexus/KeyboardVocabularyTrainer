{
  "id": "phrasebook-attheairport",
  "name": "At the Airport",
  "description": "Аэропорт: регистрация, контроль, посадка, багаж — живые фразы",
  "entries": [
    {
      "id": "pbq_airport_0",
      "word": "Excuse me, where is the check-in desk?",
      "translation": "Извините, где стойка регистрации?",
      "language": "en"
    },
    {
      "id": "pbq_airport_1",
      "word": "Which terminal does my flight leave from?",
      "translation": "С какого терминала вылетает мой рейс?",
      "language": "en"
    },
    {
      "id": "pbq_airport_2",
      "word": "I'd like a window seat, please.",
      "translation": "Я бы хотел место у окна, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_3",
      "word": "I’d prefer an aisle seat.",
      "translation": "Я бы предпочёл место у прохода.",
      "language": "en"
    },
    {
      "id": "pbq_airport_4",
      "word": "Are we taking off on time?",
      "translation": "Мы взлетаем вовремя?",
      "language": "en"
    },
    {
      "id": "pbq_airport_5",
      "word": "Is the flight on schedule?",
      "translation": "Рейс по расписанию?",
      "language": "en"
    },
    {
      "id": "pbq_airport_6",
      "word": "The flight has been delayed.",
      "translation": "Рейс задержали.",
      "language": "en"
    },
    {
      "id": "pbq_airport_7",
      "word": "How long is the delay?",
      "translation": "Какая длительность задержки?",
      "language": "en"
    },
    {
      "id": "pbq_airport_8",
      "word": "What time does boarding start?",
      "translation": "Когда начинается посадка?",
      "language": "en"
    },
    {
      "id": "pbq_airport_9",
      "word": "Here are my passport and ticket.",
      "translation": "Вот мой паспорт и билет.",
      "language": "en"
    },
    {
      "id": "pbq_airport_10",
      "word": "I’m flying to London.",
      "translation": "Я лечу в Лондон.",
      "language": "en"
    },
    {
      "id": "pbq_airport_11",
      "word": "This is my carry-on bag.",
      "translation": "Это моя ручная кладь.",
      "language": "en"
    },
    {
      "id": "pbq_airport_12",
      "word": "Can I take this on board?",
      "translation": "Могу я взять это на борт?",
      "language": "en"
    },
    {
      "id": "pbq_airport_13",
      "word": "Does this fit in the overhead bin?",
      "translation": "Это поместится на верхнюю полку?",
      "language": "en"
    },
    {
      "id": "pbq_airport_14",
      "word": "How many bags can I check in?",
      "translation": "Сколько мест багажа можно сдать?",
      "language": "en"
    },
    {
      "id": "pbq_airport_15",
      "word": "I have two suitcases to check in.",
      "translation": "Мне нужно сдать два чемодана.",
      "language": "en"
    },
    {
      "id": "pbq_airport_16",
      "word": "Could you tag this bag for me?",
      "translation": "Могли бы вы повесить бирку на этот чемодан?",
      "language": "en"
    },
    {
      "id": "pbq_airport_17",
      "word": "Do you have any liquids in your bag?",
      "translation": "В вашей сумке есть жидкости?",
      "language": "en"
    },
    {
      "id": "pbq_airport_18",
      "word": "Please put your laptop in the tray.",
      "translation": "Положите ноутбук в лоток, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_19",
      "word": "Take off your belt and shoes, please.",
      "translation": "Снимите ремень и обувь, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_20",
      "word": "Please raise your arms.",
      "translation": "Поднимите руки, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_21",
      "word": "I set off the alarm again.",
      "translation": "У меня снова сработала рамка.",
      "language": "en"
    },
    {
      "id": "pbq_airport_22",
      "word": "Where can I find gate B7?",
      "translation": "Где найти выход B7?",
      "language": "en"
    },
    {
      "id": "pbq_airport_23",
      "word": "How do I get to gate twelve?",
      "translation": "Как пройти к двенадцатому выходу?",
      "language": "en"
    },
    {
      "id": "pbq_airport_24",
      "word": "Is this the right line for boarding?",
      "translation": "Это правильная очередь на посадку?",
      "language": "en"
    },
    {
      "id": "pbq_airport_25",
      "word": "May I see your boarding pass?",
      "translation": "Можно посмотреть ваш посадочный талон?",
      "language": "en"
    },
    {
      "id": "pbq_airport_26",
      "word": "We’re now boarding passengers with children.",
      "translation": "Сейчас идёт посадка пассажиров с детьми.",
      "language": "en"
    },
    {
      "id": "pbq_airport_27",
      "word": "Final call for flight BA204!",
      "translation": "Последний вызов на рейс BA204!",
      "language": "en"
    },
    {
      "id": "pbq_airport_28",
      "word": "Where is the baggage claim?",
      "translation": "Где выдача багажа?",
      "language": "en"
    },
    {
      "id": "pbq_airport_29",
      "word": "Which carousel is for flight 512?",
      "translation": "Какая лента для рейса 512?",
      "language": "en"
    },
    {
      "id": "pbq_airport_30",
      "word": "My suitcase hasn’t arrived.",
      "translation": "Мой чемодан не приехал.",
      "language": "en"
    },
    {
      "id": "pbq_airport_31",
      "word": "One of my bags is missing.",
      "translation": "Одна из моих сумок пропала.",
      "language": "en"
    },
    {
      "id": "pbq_airport_32",
      "word": "Where is the lost and found office?",
      "translation": "Где бюро находок?",
      "language": "en"
    },
    {
      "id": "pbq_airport_33",
      "word": "I’d like to report lost luggage.",
      "translation": "Я хочу заявить об утере багажа.",
      "language": "en"
    },
    {
      "id": "pbq_airport_34",
      "word": "Here is my baggage claim ticket.",
      "translation": "Вот мой багажный талон.",
      "language": "en"
    },
    {
      "id": "pbq_airport_35",
      "word": "When will my luggage be delivered?",
      "translation": "Когда мой багаж доставят?",
      "language": "en"
    },
    {
      "id": "pbq_airport_36",
      "word": "Where is the transfer desk?",
      "translation": "Где стойка для транзитных пассажиров?",
      "language": "en"
    },
    {
      "id": "pbq_airport_37",
      "word": "I have a connecting flight to Rome.",
      "translation": "У меня пересадка на рейс до Рима.",
      "language": "en"
    },
    {
      "id": "pbq_airport_38",
      "word": "Will my luggage be transferred automatically?",
      "translation": "Багаж перенаправят автоматически?",
      "language": "en"
    },
    {
      "id": "pbq_airport_39",
      "word": "How long is the layover?",
      "translation": "Насколько долгая пересадка?",
      "language": "en"
    },
    {
      "id": "pbq_airport_40",
      "word": "Where is the currency exchange?",
      "translation": "Где обмен валюты?",
      "language": "en"
    },
    {
      "id": "pbq_airport_41",
      "word": "Where can I get a taxi?",
      "translation": "Где можно взять такси?",
      "language": "en"
    },
    {
      "id": "pbq_airport_42",
      "word": "Which way to the exit?",
      "translation": "В какую сторону выход?",
      "language": "en"
    },
    {
      "id": "pbq_airport_43",
      "word": "Is there free Wi-Fi here?",
      "translation": "Здесь есть бесплатный Wi-Fi?",
      "language": "en"
    },
    {
      "id": "pbq_airport_44",
      "word": "Where are the restrooms?",
      "translation": "Где туалеты?",
      "language": "en"
    },
    {
      "id": "pbq_airport_45",
      "word": "Where can I charge my phone?",
      "translation": "Где можно зарядить телефон?",
      "language": "en"
    },
    {
      "id": "pbq_airport_46",
      "word": "Could you watch my luggage for a minute?",
      "translation": "Присмотрите за моим багажом минуту?",
      "language": "en"
    },
    {
      "id": "pbq_airport_47",
      "word": "What is the purpose of your visit?",
      "translation": "Какова цель вашей поездки?",
      "language": "en"
    },
    {
      "id": "pbq_airport_48",
      "word": "I'm here on holiday.",
      "translation": "Я здесь на отдыхе.",
      "language": "en"
    },
    {
      "id": "pbq_airport_49",
      "word": "I'm here on business.",
      "translation": "Я приехал по работе.",
      "language": "en"
    },
    {
      "id": "pbq_airport_50",
      "word": "How long are you staying?",
      "translation": "На сколько вы остаётесь?",
      "language": "en"
    },
    {
      "id": "pbq_airport_51",
      "word": "Two weeks, until the twenty-second.",
      "translation": "Две недели, до двадцать второго.",
      "language": "en"
    },
    {
      "id": "pbq_airport_52",
      "word": "Where will you be staying?",
      "translation": "Где вы будете останавливаться?",
      "language": "en"
    },
    {
      "id": "pbq_airport_53",
      "word": "At a hotel downtown.",
      "translation": "В отеле в центре города.",
      "language": "en"
    },
    {
      "id": "pbq_airport_54",
      "word": "Anything to declare?",
      "translation": "Есть что-нибудь для декларации?",
      "language": "en"
    },
    {
      "id": "pbq_airport_55",
      "word": "Nothing to declare.",
      "translation": "Мне нечего декларировать.",
      "language": "en"
    },
    {
      "id": "pbq_airport_56",
      "word": "Open your suitcase, please.",
      "translation": "Откройте чемодан, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_57",
      "word": "These are gifts for friends.",
      "translation": "Это подарки друзьям.",
      "language": "en"
    },
    {
      "id": "pbq_airport_58",
      "word": "Welcome to our country!",
      "translation": "Добро пожаловать в нашу страну!",
      "language": "en"
    },
    {
      "id": "pbq_airport_59",
      "word": "Enjoy your stay!",
      "translation": "Приятного пребывания!",
      "language": "en"
    },
    {
      "id": "pbq_airport_60",
      "word": "Have a nice flight!",
      "translation": "Хорошего полёта!",
      "language": "en"
    },
    {
      "id": "pbq_airport_61",
      "word": "Can I change my seat?",
      "translation": "Можно поменять моё место?",
      "language": "en"
    },
    {
      "id": "pbq_airport_62",
      "word": "Is this seat taken?",
      "translation": "Это место занято?",
      "language": "en"
    },
    {
      "id": "pbq_airport_63",
      "word": "Would you swap seats with me?",
      "translation": "Не поменяешься со мной местами?",
      "language": "en"
    },
    {
      "id": "pbq_airport_64",
      "word": "Can I have a blanket, please?",
      "translation": "Можно мне одеяло, пожалуйста?",
      "language": "en"
    },
    {
      "id": "pbq_airport_65",
      "word": "Chicken or pasta?",
      "translation": "Курица или паста?",
      "language": "en"
    },
    {
      "id": "pbq_airport_66",
      "word": "Chicken, please.",
      "translation": "Курицу, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_67",
      "word": "Could I have some water?",
      "translation": "Можно немного воды?",
      "language": "en"
    },
    {
      "id": "pbq_airport_68",
      "word": "When do we land?",
      "translation": "Когда мы приземлимся?",
      "language": "en"
    },
    {
      "id": "pbq_airport_69",
      "word": "Please fasten your seatbelt.",
      "translation": "Пристегните ремни, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_70",
      "word": "Please switch your phone to airplane mode.",
      "translation": "Переведите телефон в авиарежим, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_airport_71",
      "word": "We’re experiencing some turbulence.",
      "translation": "Мы попадаем в зону турбулентности.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_0",
      "word": "I called security.",
      "translation": "Я вызвал охрану.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_1",
      "word": "It's a matter of national security.",
      "translation": "Это вопрос национальной безопасности.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_2",
      "word": "That's an unsubstantiated claim.",
      "translation": "Это голословное утверждение.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_5",
      "word": "Somebody's standing at the gate.",
      "translation": "Кто-то стоит у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_7",
      "word": "I was asked to open the gate.",
      "translation": "Меня попросили открыть ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_8",
      "word": "I'll pass the information to our sales department.",
      "translation": "Я передам информацию нашему отделу продаж.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_9",
      "word": "Shall I carry your baggage?",
      "translation": "Могу я понести ваш багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_10",
      "word": "Did you pass all your exams?",
      "translation": "Ты сдал все свои экзамены?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_11",
      "word": "I can't pass up this opportunity.",
      "translation": "Я не могу упустить такую возможность.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_14",
      "word": "Pass the rope through the ring and tie it.",
      "translation": "Пропустите верёвку через кольцо и завяжите её.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_15",
      "word": "I can't let you enter without a pass.",
      "translation": "Я не могу пустить вас без пропуска.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_16",
      "word": "Where is your boarding pass?",
      "translation": "Где ваш посадочный талон?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_17",
      "word": "Her friends waited for her by the gate.",
      "translation": "Друзья ждали её у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_18",
      "word": "Could I sit on the aisle?",
      "translation": "Можно я сяду в проходе?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_20",
      "word": "The men loaded the baggage into the truck.",
      "translation": "Мужчины погрузили багаж в грузовик.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_21",
      "word": "Thanks, but I'll pass.",
      "translation": "Спасибо, но я пас.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_22",
      "word": "The years pass by quickly.",
      "translation": "Годы пролетают быстро.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_25",
      "word": "The flights were cancelled.",
      "translation": "Полёты были отменены.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_26",
      "word": "He stepped aside for an old man to pass.",
      "translation": "Он отошёл в сторону, позволив старику пройти.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_27",
      "word": "He helped me carry the baggage.",
      "translation": "Он помог мне нести чемоданы.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_29",
      "word": "The club failed to pass our resolution.",
      "translation": "Наша резолюция не прошла в клубе.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_30",
      "word": "How many pieces of baggage do you have?",
      "translation": "Сколько у вас багажа?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_32",
      "word": "I opened the gate.",
      "translation": "Я открыл ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_33",
      "word": "The picnic hasn't been cancelled.",
      "translation": "Пикник не отменили.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_35",
      "word": "The gate needs to be closed.",
      "translation": "Нужно закрыть ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_36",
      "word": "The gate was unlocked.",
      "translation": "Ворота были не заперты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_37",
      "word": "I'll walk you to the gate.",
      "translation": "Я провожу вас до ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_39",
      "word": "I'll meet you in the baggage claims area.",
      "translation": "Я буду ждать вас в зоне получения багажа.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_41",
      "word": "Some people claim to know everything.",
      "translation": "Некоторые люди утверждают, что всё знают.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_42",
      "word": "I stood aside to let them pass.",
      "translation": "Я встал в стороне, чтобы позволить им пройти.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_43",
      "word": "Shut the gate when you leave.",
      "translation": "Закрой ворота, когда будешь уезжать.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_44",
      "word": "Where can I pick up my baggage?",
      "translation": "Где я могу забрать багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_45",
      "word": "I enjoy snowboarding.",
      "translation": "Я увлекаюсь сноубордом.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_47",
      "word": "Did you pass out?",
      "translation": "Ты потерял сознание?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_48",
      "word": "He is studying hard so that he can pass the examinations.",
      "translation": "Он усердно готовится, чтобы сдать экзамены.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_0_49",
      "word": "Where is the boarding gate for UA 111?",
      "translation": "Где выход на посадку на рейс UA 111?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_0",
      "word": "This verb is difficult to conjugate.",
      "translation": "Этот глагол трудно спрягать.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_1",
      "word": "They will not pass!",
      "translation": "Они не пройдут!",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_2",
      "word": "I claimed my baggage.",
      "translation": "Я получил свой багаж.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_4",
      "word": "They claim they're Canadians.",
      "translation": "Они утверждают, что они канадцы.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_5",
      "word": "How do I get to Gate 5?",
      "translation": "Как пройти к пятому выходу?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_6",
      "word": "The customs officials boarded the ship.",
      "translation": "Таможенники поднялись на борт судна.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_7",
      "word": "It's a matter of security.",
      "translation": "Это вопрос безопасности.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_8",
      "word": "Did you remember to lock the gate?",
      "translation": "Ты не забыл запереть ворота?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_9",
      "word": "The prophecy came to pass.",
      "translation": "Пророчество сбылось.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_10",
      "word": "The customs official inspected the boxes.",
      "translation": "Таможенник осматривал ящики.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_11",
      "word": "Here is my baggage.",
      "translation": "Вот мой багаж.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_12",
      "word": "If you want security in your old age, begin saving now.",
      "translation": "Если вы хотите безопасности в старости, то начните откладывать деньги на старость прямо сейчас.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_13",
      "word": "She took a lot of baggage with her.",
      "translation": "Она взяла с собой много багажа.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_14",
      "word": "The gate was off its hinges.",
      "translation": "Дверь была сорвана с петель.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_15",
      "word": "Pass the ketchup.",
      "translation": "Передай кетчуп.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_16",
      "word": "I like snowboarding.",
      "translation": "Я люблю кататься на сноуборде.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_17",
      "word": "I stepped aside for her to pass by.",
      "translation": "Я посторонился, чтобы пропустить её.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_18",
      "word": "Do you have a pass?",
      "translation": "У вас есть пропуск?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_21",
      "word": "I stepped aside so he could pass.",
      "translation": "Я отошёл в сторону, чтобы он смог пройти.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_22",
      "word": "He didn't pass after all.",
      "translation": "В конечном итоге он не сдал экзамен.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_23",
      "word": "That will pass.",
      "translation": "Это пройдёт.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_24",
      "word": "I'll call security.",
      "translation": "Я вызову охрану.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_25",
      "word": "I don't know how to use this compass.",
      "translation": "Я не знаю, как пользоваться этим компасом.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_26",
      "word": "Pass me the potatoes.",
      "translation": "Передай мне картошку.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_27",
      "word": "I only have this baggage.",
      "translation": "У меня с собой только этот багаж.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_29",
      "word": "A customs official asked me to open my suitcase.",
      "translation": "Таможенник попросил меня открыть чемодан.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_31",
      "word": "There are security cameras all around here.",
      "translation": "Тут кругом камеры слежения.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_32",
      "word": "Pass me the wine.",
      "translation": "Передайте мне вино.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_33",
      "word": "Have you ever tried skateboarding?",
      "translation": "Ты когда-нибудь пробовала кататься на скейтборде?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_35",
      "word": "Where's the compass?",
      "translation": "Где компас?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_36",
      "word": "I'll see you to the gate.",
      "translation": "Я провожу вас до ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_37",
      "word": "Don't pass judgment too quickly.",
      "translation": "Не судите опрометчиво.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_38",
      "word": "Is this your baggage?",
      "translation": "Это ваш багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_39",
      "word": "Pass me the spatula.",
      "translation": "Передай мне лопатку.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_40",
      "word": "I've been delayed for a few hours.",
      "translation": "Меня задержали на несколько часов.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_41",
      "word": "Where is the south terminal?",
      "translation": "Где находится южный терминал?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_42",
      "word": "Could you pass me the maple syrup?",
      "translation": "Вы не могли бы передать мне кленовый сироп?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_43",
      "word": "Unfortunately, I'll have to pass.",
      "translation": "К сожалению, мне придётся пройти.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_44",
      "word": "You know more than I do about German customs and traditions.",
      "translation": "Ты больше меня знаешь о немецких обычаях и традициях.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_45",
      "word": "Don't just stand there. Call security.",
      "translation": "Не стой там столбом. Позови охрану.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_46",
      "word": "Could you pass the spaghetti?",
      "translation": "Вы не могли бы передать спагетти?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_47",
      "word": "I didn't pass.",
      "translation": "Я не прошёл.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_48",
      "word": "The gate was open.",
      "translation": "Ворота были открыты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_1_49",
      "word": "I'm calling security.",
      "translation": "Я вызываю охрану.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_0",
      "word": "Lock the gate.",
      "translation": "Запри ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_1",
      "word": "I'll wait for you at the gate.",
      "translation": "Я буду ждать тебя у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_2",
      "word": "I hope you pass all your exams.",
      "translation": "Надеюсь, ты сдашь все экзамены.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_4",
      "word": "You can't take any excess baggage on the plane.",
      "translation": "Вы не можете брать с собой в самолёт багаж сверх нормы.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_5",
      "word": "Where can I check my baggage?",
      "translation": "Где я могу зарегистрировать свой багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_6",
      "word": "Did anybody call for security?",
      "translation": "Кто-нибудь вызвал охрану?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_7",
      "word": "The gate is open now.",
      "translation": "Ворота сейчас открыты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_8",
      "word": "Pass me the salt, will you?",
      "translation": "Вы можете передать мне соль?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_9",
      "word": "Where do I claim my bags?",
      "translation": "Где я могу забрать багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_11",
      "word": "Where is the check-in counter?",
      "translation": "Где стойка регистрации?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_12",
      "word": "Where do I claim my baggage?",
      "translation": "Где я могу получить свой багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_13",
      "word": "Are you making a pass at me?",
      "translation": "Ты ко мне подкатываешь?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_15",
      "word": "All things must pass.",
      "translation": "Всё когда-нибудь проходит.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_16",
      "word": "Don't try to pass the buck.",
      "translation": "Не пытайся переложить ответственность.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_17",
      "word": "Can you prove your claim?",
      "translation": "Ты можешь доказать свое утверждение?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_19",
      "word": "Where can I get my baggage?",
      "translation": "Где я могу забрать свой багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_20",
      "word": "They were delayed due to heavy snowfall.",
      "translation": "Из-за сильного снегопада они задержались.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_21",
      "word": "We have to respect local customs.",
      "translation": "Мы должны уважать местные обычаи.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_22",
      "word": "I closed the gate.",
      "translation": "Я закрыл ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_23",
      "word": "Days pass by quickly when you're busy.",
      "translation": "Дни быстро проходят, когда ты занят.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_24",
      "word": "The Brandenburg Gate is one of the most famous landmarks in Germany.",
      "translation": "Бранденбургские ворота — один из самых известных архитектурных памятников в Германии.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_27",
      "word": "Pass me the pen.",
      "translation": "Передайте мне ручку.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_29",
      "word": "The gate opened.",
      "translation": "Ворота открылись.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_30",
      "word": "I can't pass up this chance.",
      "translation": "Я не могу упустить такой шанс.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_31",
      "word": "There are two motorcycles at the gate of the park.",
      "translation": "У ворот парка стоят два мотоцикла.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_32",
      "word": "I don't have any baggage.",
      "translation": "У меня нет багажа.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_33",
      "word": "I will not let you pass.",
      "translation": "Я не дам тебе пройти.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_34",
      "word": "I expect her to pass the examination easily.",
      "translation": "Я думаю, она с лёгкостью сдаст экзамен.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_35",
      "word": "Where's your baggage?",
      "translation": "Где ваш багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_36",
      "word": "The gate is locked.",
      "translation": "Ворота заперты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_38",
      "word": "He made me carry his baggage.",
      "translation": "Он заставил меня нести его багаж.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_39",
      "word": "Did you pass your exams?",
      "translation": "Вы сдали экзамены?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_40",
      "word": "The gate was too narrow for the truck.",
      "translation": "Ворота были слишком узкими для грузовика.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_41",
      "word": "Can you pass me the milk?",
      "translation": "Можешь передать мне молоко?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_42",
      "word": "The gate was locked.",
      "translation": "Ворота были заперты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_43",
      "word": "They walked toward the gate.",
      "translation": "Они пошли к воротам.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_44",
      "word": "Our security cameras are fake.",
      "translation": "Наши камеры слежения не настоящие.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_45",
      "word": "Can you justify your claim?",
      "translation": "Можете ли вы обосновать ваше утверждение?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_46",
      "word": "The gate is open.",
      "translation": "Ворота открыты.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_47",
      "word": "The old man stood motionless by the gate.",
      "translation": "Старик неподвижно стоял у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_48",
      "word": "He wasn't about to pass up that once-in-a-lifetime chance.",
      "translation": "Он не собирался упускать шанс, который выпадает раз в жизни.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_2_49",
      "word": "It's a question of security.",
      "translation": "Это вопрос безопасности.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_0",
      "word": "They won't let this pass.",
      "translation": "Они не дадут этому хода.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_3",
      "word": "Open the gate.",
      "translation": "Открой ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_4",
      "word": "Did you shut the gate?",
      "translation": "Ты закрыл ворота?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_6",
      "word": "Can someone call security?",
      "translation": "Может кто-то вызвать охрану?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_7",
      "word": "They have no claim to the property.",
      "translation": "У них нет претензий на собственность.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_8",
      "word": "Someone is standing at the gate.",
      "translation": "Кто-то стоит у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_9",
      "word": "They asked me to open the gate.",
      "translation": "Они попросили меня открыть ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_11",
      "word": "They were waiting for the gate to open.",
      "translation": "Они ждали, когда откроются ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_13",
      "word": "Where do I go after I pick up my baggage?",
      "translation": "Куда мне идти после того, как я получу свой багаж?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_14",
      "word": "All commercial goods and packages from abroad go through customs.",
      "translation": "Все коммерческие товары и посылки из-за рубежа проходят через таможню.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_15",
      "word": "There's a man at the gate who wants to see you.",
      "translation": "Там у ворот человек, который хочет тебя видеть.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_16",
      "word": "This is a matter of national security.",
      "translation": "Это вопрос национальной безопасности.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_17",
      "word": "We've installed several security cameras.",
      "translation": "Мы установили несколько камер наблюдения.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_18",
      "word": "Many old customs are gradually dying out.",
      "translation": "Многие старинные обычаи постепенно отмирают.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_20",
      "word": "I bought a VIP pass.",
      "translation": "Я купил VIP-пропуск.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_21",
      "word": "We're at the gate.",
      "translation": "Мы у ворот.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_22",
      "word": "She was afraid to pass through the woods.",
      "translation": "Она боялась идти через лес.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_23",
      "word": "This ship is too big to pass through the canal.",
      "translation": "Этот корабль слишком крупный, чтобы пройти по каналу.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_24",
      "word": "Who opened the gate?",
      "translation": "Кто открыл ворота?",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_25",
      "word": "Shut the gate.",
      "translation": "Закрой ворота.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_26",
      "word": "We had to show our papers at the security desk.",
      "translation": "Нам пришлось показать наши бумаги на пункте охраны.",
      "language": "en"
    },
    {
      "id": "pb_attheairport_3_27",
      "word": "How can you justify your claim?",
      "translation": "Чем вы можете обосновать свои требования?",
      "language": "en"
    }
  ]
}
