{
  "id": "phrasebook-atthedoctor",
  "name": "At the Doctor",
  "description": "У врача: жалобы, симптомы, лечение и рецепты",
  "entries": [
    {
      "id": "pbq_doctor_0",
      "word": "I’d like to make an appointment with a doctor.",
      "translation": "Я хотел бы записаться на приём к врачу.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_1",
      "word": "Can I see a doctor today?",
      "translation": "Можно попасть к врачу сегодня?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_2",
      "word": "It’s not urgent, but soon please.",
      "translation": "Это не срочно, но как можно скорее, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_3",
      "word": "Please fill out this form.",
      "translation": "Заполните эту форму, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_4",
      "word": "Do you have medical insurance?",
      "translation": "У вас есть медицинская страховка?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_5",
      "word": "Here is my insurance card.",
      "translation": "Вот моя страховая карта.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_6",
      "word": "What seems to be the problem?",
      "translation": "Что вас беспокоит?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_7",
      "word": "Where does it hurt?",
      "translation": "Где у вас болит?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_8",
      "word": "I have a splitting headache.",
      "translation": "У меня сильная головная боль.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_9",
      "word": "My throat hurts when I swallow.",
      "translation": "У меня болит горло, когда глотаю.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_10",
      "word": "I have a sharp pain in my side.",
      "translation": "У меня острая боль в боку.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_11",
      "word": "It hurts when I press here.",
      "translation": "Болит, когда нажимаю здесь.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_12",
      "word": "The pain comes and goes.",
      "translation": "Боль то появляется, то проходит.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_13",
      "word": "The pain gets worse at night.",
      "translation": "Ночью боль усиливается.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_14",
      "word": "Since when have you had these symptoms?",
      "translation": "Давно ли у вас эти симптомы?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_15",
      "word": "For about three days now.",
      "translation": "Уже около трёх дней.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_16",
      "word": "I feel dizzy.",
      "translation": "У меня головокружение.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_17",
      "word": "I feel nauseous.",
      "translation": "Меня тошнит.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_18",
      "word": "I keep coughing at night.",
      "translation": "Я постоянно кашляю по ночам.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_19",
      "word": "I can’t stop sneezing.",
      "translation": "Не могу перестать чихать.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_20",
      "word": "My nose is stuffed up.",
      "translation": "У меня заложен нос.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_21",
      "word": "I have a runny nose.",
      "translation": "У меня насморк.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_22",
      "word": "I’m running a temperature.",
      "translation": "У меня повышенная температура.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_23",
      "word": "I have a fever of thirty-nine degrees.",
      "translation": "У меня температура тридцать девять.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_24",
      "word": "I feel weak all over.",
      "translation": "Я чувствую слабость во всём теле.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_25",
      "word": "I have no appetite.",
      "translation": "У меня нет аппетита.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_26",
      "word": "I can’t sleep because of the pain.",
      "translation": "Я не могу спать из-за боли.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_27",
      "word": "Have you taken anything for it?",
      "translation": "Вы что-нибудь принимали от этого?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_28",
      "word": "Just painkillers so far.",
      "translation": "Пока только обезболивающие.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_29",
      "word": "Are you allergic to any medication?",
      "translation": "У вас есть аллергия на какие-либо лекарства?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_30",
      "word": "I’m allergic to penicillin.",
      "translation": "У меня аллергия на пенициллин.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_31",
      "word": "Are you taking any other medications?",
      "translation": "Принимаете ли вы другие лекарства?",
      "language": "en"
    },
    {
      "id": "pbq_doctor_32",
      "word": "Let me listen to your lungs.",
      "translation": "Давайте послушаю ваши лёгкие.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_33",
      "word": "Breathe in deeply… and out.",
      "translation": "Глубоко вдохните... и выдохните.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_34",
      "word": "Open your mouth wide, please.",
      "translation": "Откройте рот пошире, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_35",
      "word": "Say “ahh”.",
      "translation": "Скажите «а-а-ах».",
      "language": "en"
    },
    {
      "id": "pbq_doctor_36",
      "word": "Roll up your sleeve, please.",
      "translation": "Закатайте рукав, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_37",
      "word": "I’ll check your blood pressure.",
      "translation": "Я измерю ваше давление.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_38",
      "word": "Your blood pressure is a bit high.",
      "translation": "У вас немного повышено давление.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_39",
      "word": "You need a blood test.",
      "translation": "Вам нужно сдать анализ крови.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_40",
      "word": "Nothing serious, just a common cold.",
      "translation": "Ничего серьёзного, обычная простуда.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_41",
      "word": "You have the flu.",
      "translation": "У вас грипп.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_42",
      "word": "It looks like bronchitis.",
      "translation": "Похоже на бронхит.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_43",
      "word": "You’ll need antibiotics.",
      "translation": "Вам понадобятся антибиотики.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_44",
      "word": "I’ll prescribe you something stronger.",
      "translation": "Я выпишу вам что-то посильнее.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_45",
      "word": "Take one tablet twice a day after meals.",
      "translation": "Принимайте по одной таблетке два раза в день после еды.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_46",
      "word": "Take it with plenty of water.",
      "translation": "Запивайте большим количеством воды.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_47",
      "word": "Finish the whole course of antibiotics.",
      "translation": "Пропейте весь курс антибиотиков.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_48",
      "word": "Get plenty of rest and drink fluids.",
      "translation": "Много отдыхайте и пейте жидкость.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_49",
      "word": "Come back if it doesn’t improve.",
      "translation": "Приходите снова, если не станет лучше.",
      "language": "en"
    },
    {
      "id": "pbq_doctor_50",
      "word": "You should stay home from work.",
