    {
      "id": "pbq_cafebar_2",
      "word": "An espresso, please.",
      "translation": "Эспрессо, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_3",
      "word": "Large black coffee, please.",
      "translation": "Большой чёрный кофе, пожалуйста.",
      "language": "en"
