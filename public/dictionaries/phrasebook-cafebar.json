    {
      "id": "pbq_cafebar_12",
      "word": "For here or to go?",
      "translation": "Здесь будете пить или с собой?",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_13",
      "word": "To go, please.",
      "translation": "С собой, пожалуйста.",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_14",
      "word": "Can I warm up my cup?",
      "translation": "Можно подогреть мою кружку?",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_15",
