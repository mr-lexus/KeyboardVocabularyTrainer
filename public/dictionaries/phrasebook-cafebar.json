    {
      "id": "pbq_cafebar_5",
      "word": "With milk and two sugars.",
      "translation": "С молоком и двумя ложками сахара.",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_6",
      "word": "No sugar, thanks.",
      "translation": "Без сахара, спасибо.",
      "language": "en"
    },
    {
      "id": "pbq_cafebar_7",
      "word": "Soy milk, please.",
