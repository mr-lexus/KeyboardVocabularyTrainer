      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_16",
      "word": "I'm the one who has your helmet.",
      "translation": "Твой шлем у меня.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_18",
      "word": "The pilot wasn't injured when the plane crashed.",
      "translation": "При падении самолёта лётчик не пострадал.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_21",
      "word": "Where is your helmet?",
      "translation": "Где твой шлем?",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_23",
