    {
      "id": "pb_motorsportdriver_0_1",
      "word": "Go get your helmet.",
      "translation": "Иди надень каску.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_2",
      "word": "That helmet saved your life.",
      "translation": "Этот шлем спас тебе жизнь.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_3",
      "word": "I'm a pilot.",
      "translation": "Я пилот.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_5",
      "word": "The pilot bailed out before the plane crashed.",
      "translation": "Пилот катапультировался, перед тем как самолёт разбился.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_7",
      "word": "I want to be a pilot in the future.",
      "translation": "Я хочу стать пилотом в будущем.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_8",
      "word": "He's the king's most trusted advisor.",
      "translation": "Он ближайший советник короля.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_11",
      "word": "You didn't tell me that you were a pilot.",
