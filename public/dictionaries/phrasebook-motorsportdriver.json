      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_24",
      "word": "I need a helmet.",
      "translation": "Мне нужен шлем.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_25",
      "word": "Is there a pilot on this plane?",
      "translation": "В этом самолёте есть пилот?",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_27",
      "word": "Is this your helmet?",
      "translation": "Это твой шлем?",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_30",
      "word": "I want to be a pilot.",
      "translation": "Я хочу быть лётчиком.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_33",
      "word": "A bullet pierced the helmet.",
      "translation": "Шлем пробила пуля.",
      "language": "en"
    },
    {
      "id": "pb_motorsportdriver_0_34",
      "word": "He decided to become a pilot.",
